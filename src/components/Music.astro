---
import { getAlbums, mapAlbum } from '../lib/contentful';

const albums = (await getAlbums()).map(mapAlbum);
import { translations } from '../i18n/index.js';

const { locale = 'en' } = Astro.props;
const t = translations[locale as keyof typeof translations];

const PAGE_SIZE = 6;
const albumPages: (typeof albums)[] = [];
for (let i = 0; i < albums.length; i += PAGE_SIZE) {
  albumPages.push(albums.slice(i, i + PAGE_SIZE));
}
const hasMultiplePages = albumPages.length > 1;
---

<section id={locale === 'en' ? 'music' : 'musique'} class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <h2 class="font-archivo text-4xl md:text-5xl text-center mb-16 text-neutral-900">{t.music.title}</h2>
    <div class="flex flex-col md:flex-row items-center justify-center gap-6 max-w-6xl mx-auto">
      {hasMultiplePages && (
        <div class="order-2 md:order-1 flex flex-row md:flex-col gap-4">
          <button
            id="album-prev"
            type="button"
            aria-label={t.music.prevAlbums}
            disabled
            class="p-3 rounded-full border border-primary-600 text-primary-600 transition-all duration-300 hover:bg-primary-50 disabled:opacity-30 disabled:cursor-default disabled:hover:bg-transparent"
          >
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
            </svg>
          </button>
          <button
            id="album-next"
            type="button"
            aria-label={t.music.nextAlbums}
            class="p-3 rounded-full border border-primary-600 text-primary-600 transition-all duration-300 hover:bg-primary-50 disabled:opacity-30 disabled:cursor-default disabled:hover:bg-transparent"
          >
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      )}
      <div id="album-viewport" class="order-1 md:order-2 w-full overflow-hidden">
        {albumPages.map((page, pageIndex) => (
          <div
            class={`album-page flex flex-wrap justify-center gap-8 transition-all duration-300 ease-in-out${pageIndex === 0 ? '' : ' hidden'}`}
            data-page={pageIndex}
          >
            {page.map(album => (
              <div class="bg-neutral-50 p-6 rounded-lg border border-neutral-200 text-center w-full md:w-80">
                <img
                  src={album.coverImage}
                  alt={`Album Cover - ${album.title}`}
                  class="w-full aspect-square object-cover rounded-lg mb-6 mx-auto"
                />
                <h3 class="text-xl font-semibold mb-2">{album.title}</h3>
                <div class="flex justify-center gap-4">
                  <a
                    href={album.spotifyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-6 py-2 bg-primary-600 text-white rounded hover:bg-primary-700 transition-colors duration-300 inline-flex items-center gap-2"
                  >
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                    </svg>
                    {locale === 'en' ? 'Listen' : 'Écouter'}
                  </a>
                  <a
                    href={`${locale === 'en' ? '/en' : '/fr'}/lyrics/${album.id}`}
                    class="px-6 py-2 bg-white text-primary-600 rounded border border-primary-600 hover:bg-primary-50 transition-colors duration-300"
                  >
                    {locale === 'en' ? 'Lyrics' : 'Paroles'}
                  </a>
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const viewport = document.getElementById('album-viewport');
  const prevBtn = document.getElementById('album-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('album-next') as HTMLButtonElement | null;

  if (viewport && prevBtn && nextBtn) {
    const pages = Array.from(viewport.querySelectorAll<HTMLElement>('.album-page'));
    const ANIMATION_MS = 300;
    let current = 0;
    let animating = false;

    const updateButtons = () => {
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === pages.length - 1;
    };

    const showPage = (target: number, direction: 'up' | 'down') => {
      if (animating || target === current || target < 0 || target >= pages.length) return;
      animating = true;

      const oldPage = pages[current];
      const newPage = pages[target];
      // "down" = next page: old content exits upward, new content enters from below.
      const exitClass = direction === 'down' ? '-translate-y-6' : 'translate-y-6';
      const enterClass = direction === 'down' ? 'translate-y-6' : '-translate-y-6';

      oldPage.classList.add('opacity-0', exitClass);

      window.setTimeout(() => {
        oldPage.classList.add('hidden');
        oldPage.classList.remove('opacity-0', exitClass);

        newPage.classList.remove('hidden');
        newPage.classList.add('opacity-0', enterClass);

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            newPage.classList.remove('opacity-0', enterClass);
          });
        });

        current = target;
        updateButtons();

        window.setTimeout(() => {
          animating = false;
        }, ANIMATION_MS);
      }, ANIMATION_MS);
    };

    prevBtn.addEventListener('click', () => showPage(current - 1, 'up'));
    nextBtn.addEventListener('click', () => showPage(current + 1, 'down'));

    updateButtons();
  }
</script>
